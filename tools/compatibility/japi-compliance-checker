#!/bin/sh
# JAPICC closes javap's diagnostic pipe before the JVM prints its options banner.
# Keep JVM options and heap limits intact; ignore SIGPIPE only in this subtree.
trap '' PIPE

# Find the installed checker after this launcher in PATH. Do not recurse into
# this file, even when PATH contains duplicate or symlinked directories.
previous_ifs=$IFS
IFS=:
for directory in $PATH; do
    IFS=$previous_ifs
    candidate=${directory:-.}/japi-compliance-checker
    if [ -f "$candidate" ] && [ -x "$candidate" ] && ! [ "$candidate" -ef "$0" ]; then
        exec "$candidate" "$@"
    fi
    IFS=:
done
IFS=$previous_ifs
echo 'No installed japi-compliance-checker found after the Chronicle launcher' >&2
exit 127
