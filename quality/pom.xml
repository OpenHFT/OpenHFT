<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>net.openhft</groupId>
        <artifactId>root-parent-pom</artifactId>
        <version>2026.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>quality</artifactId>
    <packaging>jar</packaging>
    <name>OpenHFT/Quality Rules JAR</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- JVM args for Surefire - empty on Java 8, set by profiles on Java 9+ -->
        <jvm.requiredArgs></jvm.requiredArgs>
        <jvm.extraArgs></jvm.extraArgs>
        <!-- Enable strict quality enforcement for this module -->
        <quality.enforced>true</quality.enforced>
        <!-- Use checkstyle26 baseline for this module -->
        <maven.checkstyle.config.location>net/openhft/quality/checkstyle26/chronicle-baseline-checkstyle.xml
        </maven.checkstyle.config.location>
        <maven.checkstyle.suppressions.location>net/openhft/quality/checkstyle26/checkstyle-suppressions.xml
        </maven.checkstyle.suppressions.location>
        <!-- Use pmd26 baseline ruleset for this module -->
        <pmd.ruleset>net/openhft/quality/pmd26/pmd-ruleset.xml</pmd.ruleset>
        <!-- Use spotbugs26 baseline for this module -->
        <spotbugs.excludeFilterFile>net/openhft/quality/spotbugs26/chronicle-spotbugs-exclude.xml
        </spotbugs.excludeFilterFile>

        <!-- Coverage thresholds: 93.8% line / 81.1% branch -->
        <!-- Updated after refreshing JaCoCo coverage -->
        <jacoco.line.coverage>0.938</jacoco.line.coverage>
        <jacoco.branch.coverage>0.81</jacoco.branch.coverage>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>net.openhft</groupId>
                <artifactId>third-party-bom</artifactId>
                <version>2026.0-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>9.3</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>9.3</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>5.10.5</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <version>5.10.5</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Required by checkstyle test utilities -->
        <dependency>
            <groupId>com.google.truth</groupId>
            <artifactId>truth</artifactId>
            <version>1.4.4</version>
            <scope>test</scope>
        </dependency>

        <!-- SLF4J for test logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JaCoCo for code coverage -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.coverage}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} ${jvm.requiredArgs} ${jvm.extraArgs}</argLine>
                    <parallel>classes</parallel>
                    <threadCount>4</threadCount>
                    <perCoreThreadCount>false</perCoreThreadCount>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>pitest</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                                <configuration>
                                    <propertyName>argLine</propertyName>
                                </configuration>
                            </execution>

                            <execution>
                                <id>report</id>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                                <phase>verify</phase>
                                <configuration>
                                    <formats>
                                        <format>HTML</format>
                                        <format>XML</format>
                                        <format>CSV</format>
                                    </formats>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.22.0</version>
                        <dependencies>
                            <!-- JUnit 5 support -->
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.1</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <!-- Target production packages (** includes subpackages) -->
                            <targetClasses>
                                <param>net.openhft.quality.**</param>
                            </targetClasses>
                            <!-- Target tests (** includes subpackages) -->
                            <targetTests>
                                <param>net.openhft.quality.**</param>
                            </targetTests>
                            <!-- Build settings -->
                            <threads>4</threads>
                            <timeoutFactor>2</timeoutFactor>
                            <jvmArgs>
                                <param>-Xmx2g</param>
                            </jvmArgs>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                            <!-- Mutation thresholds -->
                            <!-- Updated after adding unit tests for AST support classes -->
                            <mutationThreshold>80</mutationThreshold>
                            <coverageThreshold>94</coverageThreshold>
                            <!-- Run all tests against all mutations for accuracy -->
                            <fullMutationMatrix>true</fullMutationMatrix>
                            <!-- Reduce noise from logging -->
                            <avoidCallsTo>
                                <avoidCallsTo>java.util.logging</avoidCallsTo>
                                <avoidCallsTo>org.slf4j</avoidCallsTo>
                            </avoidCallsTo>
                            <!-- Exclude methods that cause RUN_ERROR due to test harness failures -->
                            <!-- These are record/enum accessors and static lookups used in test setup -->
                            <excludedMethods>
                                <param>forCode</param>
                                <param>hasSubstance</param>
                                <param>diagnosis</param>
                                <param>verboseDetails</param>
                                <param>minWordCount</param>
                                <param>minMeaningfulWordCount</param>
                            </excludedMethods>
                            <!-- Exclude slow integration test that causes timeouts -->
                            <excludedTestClasses>
                                <param>net.openhft.quality.QualityCheckstyleSelfTest</param>
                            </excludedTestClasses>
                        </configuration>
                        <executions>
                            <execution>
                                <id>pit</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
