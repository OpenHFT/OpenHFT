<?xml version="1.0" encoding="UTF-8"?>
<!--
  chronicle-spotbugs-include.xml

  Include filter: restricts SpotBugs to the curated low-noise rules
  used across Chronicle builds.

  - Use as <includeFilterFile> in the SpotBugs Maven plugin.
  - Each <Match> activates a single bug pattern.
  - IS2_INCONSISTENT_SYNC is intentionally commented out for now;
    see NOTE in the report / playbook.

  When this file is configured as includeFilterFile, any bug pattern
  NOT listed here will be ignored.
-->
<FindBugsFilter>

    <!-- DMI_*: Dangerous method invocations / DB / file handling -->
    <Match>
        <Bug pattern="DMI_EMPTY_DB_PASSWORD"/>
    </Match>
    <Match>
        <Bug pattern="DMI_ENTRY_SETS_MAY_REUSE_ENTRY_OBJECTS"/>
    </Match>
    <Match>
        <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME"/>
    </Match>
    <Match>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>
    <Match>
        <Bug pattern="DM_EXIT"/>
    </Match>
    <Match>
        <Bug pattern="DM_GC"/>
    </Match>
    <Match>
        <Bug pattern="DM_STRING_VOID_CTOR"/>
    </Match>

    <!-- EC_/EQ_: equals/compareTo contracts -->
    <Match>
        <Bug pattern="EC_UNRELATED_CLASS_AND_INTERFACE"/>
    </Match>
    <Match>
        <Bug pattern="EQ_COMPARETO_USE_OBJECT_EQUALS"/>
    </Match>
    <Match>
        <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/>
    </Match>

    <!-- IC_/ICAST: initialisation / integer casts -->
    <Match>
        <Bug pattern="IC_INIT_CIRCULARITY"/>
    </Match>
    <Match>
        <Bug pattern="IC_SUPERCLASS_USES_SUBCLASS_DURING_INITIALIZATION"/>
    </Match>
    <Match>
        <Bug pattern="ICAST_IDIV_CAST_TO_DOUBLE"/>
    </Match>
    <Match>
        <Bug pattern="ICAST_INTEGER_MULTIPLY_CAST_TO_LONG"/>
    </Match>

    <!-- JLM_/LI_/VO_/UG_/WA_: concurrency & visibility -->
    <Match>
        <Bug pattern="JLM_JSR166_UTILCONCURRENT_MONITORENTER"/>
    </Match>
    <Match>
        <Bug pattern="LI_LAZY_INIT_STATIC"/>
    </Match>
    <Match>
        <Bug pattern="SING_SINGLETON_GETTER_NOT_SYNCHRONIZED"/>
    </Match>
    <Match>
        <Bug pattern="SING_SINGLETON_HAS_NONPRIVATE_CONSTRUCTOR"/>
    </Match>
    <Match>
        <Bug pattern="STCAL_INVOKE_ON_STATIC_DATE_FORMAT_INSTANCE"/>
    </Match>
    <Match>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    </Match>
    <Match>
        <Bug pattern="UG_SYNC_SET_UNSYNC_GET"/>
    </Match>
    <Match>
        <Bug pattern="VO_VOLATILE_INCREMENT"/>
    </Match>
    <Match>
        <Bug pattern="WA_AWAIT_NOT_IN_LOOP"/>
    </Match>

    <!-- MF_/MS_/SS_: fields and mutability -->
    <Match>
        <Bug pattern="MF_CLASS_MASKS_FIELD"/>
    </Match>
    <Match>
        <Bug pattern="MS_CANNOT_BE_FINAL"/>
    </Match>
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="MS_MUTABLE_ARRAY"/>
    </Match>
    <Match>
        <Bug pattern="MS_MUTABLE_COLLECTION_PKGPROTECT"/>
    </Match>
    <Match>
        <Bug pattern="MS_PKGPROTECT"/>
    </Match>
    <Match>
        <Bug pattern="MS_SHOULD_BE_FINAL"/>
    </Match>
    <Match>
        <Bug pattern="SS_SHOULD_BE_STATIC"/>
    </Match>

    <!-- NM_*: naming -->
    <Match>
        <Bug pattern="NM_CLASS_NAMING_CONVENTION"/>
    </Match>
    <Match>
        <Bug pattern="NM_METHOD_NAMING_CONVENTION"/>
    </Match>
    <Match>
        <Bug pattern="NM_SAME_SIMPLE_NAME_AS_INTERFACE"/>
    </Match>
    <Match>
        <Bug pattern="NM_SAME_SIMPLE_NAME_AS_SUPERCLASS"/>
    </Match>

    <!-- NP_/RCN_: nullness & redundant null checks -->
    <Match>
        <Bug pattern="NP_ALWAYS_NULL"/>
    </Match>
    <Match>
        <Bug pattern="NP_BOOLEAN_RETURN_NULL"/>
    </Match>
    <Match>
        <Bug pattern="NP_DEREFERENCE_OF_READLINE_VALUE"/>
    </Match>
    <Match>
        <Bug pattern="NP_GUARANTEED_DEREF"/>
    </Match>
    <Match>
        <Bug pattern="NP_IMMEDIATE_DEREFERENCE_OF_READLINE"/>
    </Match>
    <Match>
        <Bug pattern="NP_LOAD_OF_KNOWN_NULL_VALUE"/>
    </Match>
    <Match>
        <Bug pattern="NP_METHOD_PARAMETER_TIGHTENS_ANNOTATION"/>
    </Match>
    <Match>
        <Bug pattern="NP_NONNULL_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
    </Match>
    <Match>
        <Bug pattern="NP_NONNULL_RETURN_VIOLATION"/>
    </Match>
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_EXCEPTION"/>
    </Match>
    <Match>
        <Bug pattern="NP_PARAMETER_MUST_BE_NONNULL_BUT_MARKED_AS_NULLABLE"/>
    </Match>
    <Match>
        <Bug pattern="NP_TOSTRING_COULD_RETURN_NULL"/>
    </Match>
    <Match>
        <Bug pattern="NP_UNWRITTEN_FIELD"/>
    </Match>
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_WOULD_HAVE_BEEN_A_NPE"/>
    </Match>

    <!-- NS_/RC_: miscellaneous correctness -->
    <Match>
        <Bug pattern="NS_DANGEROUS_NON_SHORT_CIRCUIT"/>
    </Match>
    <Match>
        <Bug pattern="RC_REF_COMPARISON_BAD_PRACTICE_BOOLEAN"/>
    </Match>

    <!-- OBL_/OS_: resource management -->
    <Match>
        <Bug pattern="OBL_UNSATISFIED_OBLIGATION"/>
    </Match>
    <Match>
        <Bug pattern="OS_OPEN_STREAM"/>
    </Match>

    <!-- SE_/SF_/SBSC_/SS_/STCAL_: serialisation & switch & StringBuffer -->
    <Match>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>
    <Match>
        <Bug pattern="SE_COMPARATOR_SHOULD_BE_SERIALIZABLE"/>
    </Match>
    <Match>
        <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED"/>
    </Match>
    <Match>
        <Bug pattern="SF_SWITCH_FALLTHROUGH"/>
    </Match>
    <Match>
        <Bug pattern="SF_SWITCH_NO_DEFAULT"/>
    </Match>
    <Match>
        <Bug pattern="SBSC_USE_STRINGBUFFER_CONCATENATION"/>
    </Match>

    <!-- U*F_/UR*_/UC_*: unused / useless / uninitialised -->
    <Match>
        <Bug pattern="UUF_UNUSED_FIELD"/>
    </Match>
    <Match>
        <Bug pattern="URF_UNREAD_FIELD"/>
    </Match>
    <Match>
        <Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"/>
    </Match>
    <Match>
        <Bug pattern="UR_UNINIT_READ"/>
    </Match>
    <Match>
        <Bug pattern="UWF_NULL_FIELD"/>
    </Match>
    <Match>
        <Bug pattern="UWF_UNWRITTEN_FIELD"/>
    </Match>
    <Match>
        <Bug pattern="UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/>
    </Match>
    <Match>
        <Bug pattern="UC_USELESS_CONDITION"/>
    </Match>
    <Match>
        <Bug pattern="UC_USELESS_OBJECT"/>
    </Match>
    <Match>
        <Bug pattern="UC_USELESS_VOID_METHOD"/>
    </Match>

    <!-- UPM_/UMAC_: unused methods -->
    <Match>
        <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/>
    </Match>
    <Match>
        <Bug pattern="UMAC_UNCALLABLE_METHOD_OF_ANONYMOUS_CLASS"/>
    </Match>

    <!-- BX_/BIT_/INT_: boxing and integer issues -->
    <Match>
        <Bug pattern="BX_UNBOXING_IMMEDIATELY_REBOXED"/>
    </Match>
    <Match>
        <Bug pattern="BIT_ADD_OF_SIGNED_BYTE"/>
    </Match>
    <Match>
        <Bug pattern="INT_VACUOUS_BIT_OPERATION"/>
    </Match>
    <Match>
        <Bug pattern="BC_IMPOSSIBLE_CAST"/>
    </Match>
    <Match>
        <Bug pattern="BC_UNCONFIRMED_CAST"/>
    </Match>
    <Match>
        <Bug pattern="BC_VACUOUS_INSTANCEOF"/>
    </Match>

    <!-- ENV_/HSM_/ME_/MS_/WMI_: misc style / API -->
    <Match>
        <Bug pattern="ENV_USE_PROPERTY_INSTEAD_OF_ENV"/>
    </Match>
    <Match>
        <Bug pattern="HSM_HIDING_METHOD"/>
    </Match>
    <Match>
        <Bug pattern="ME_ENUM_FIELD_SETTER"/>
    </Match>
    <Match>
        <Bug pattern="WMI_WRONG_MAP_ITERATOR"/>
    </Match>

    <!-- RV_*/VA_*: ignored return values, format portability -->
    <Match>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE"/>
    </Match>
    <Match>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
    </Match>
    <Match>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>

    <!-- SS_SHOULD_BE_STATIC already above; DM_DEFAULT_ENCODING intentionally excluded to avoid legacy behaviour churn -->

</FindBugsFilter>
