        <Class name="net.openhft.chronicle.core.util.ClassNotFoundRuntimeExceptionTest"/>
    </Match>

    <!-- URF in ObjectUtils tests: fields exist only to drive reflection-based helpers -->
    <Match>
        <Bug pattern="URF_UNREAD_FIELD"/>
        <Class name="net.openhft.chronicle.core.util.ObjectUtilsConvertToTest$DEnum"/>
    </Match>
    <Match>
        <Bug pattern="URF_UNREAD_FIELD"/>
        <Class name="net.openhft.chronicle.core.util.ObjectUtilsTest$ClassWithSetter"/>
    </Match>

    <!-- URF in AbstractInvocationHandlerTest: cached exampleMethod / handler are exercised indirectly via mocks -->
    <Match>
        <Bug pattern="URF_UNREAD_FIELD"/>
        <Class name="net.openhft.chronicle.core.util.AbstractInvocationHandlerTest"/>
    </Match>

    <!-- SystemTimeProvider CLOCK mutability is intentional for testability -->
    <Match>
        <Bug pattern="MS_CANNOT_BE_FINAL"/>
        <Class name="net.openhft.chronicle.core.time.SystemTimeProvider"/>
        <Field name="CLOCK"/>
    </Match>

    <!-- RecordingHistogram tests rebind CLOCK to a SetTimeProvider in a controlled way -->
    <Match>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
        <Class name="net.openhft.chronicle.core.util.RecordingHistogramTest"/>
        <Method name="testSampleNanosAndTopDurations"/>
    </Match>
    <Match>
        <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/>
        <Class name="net.openhft.chronicle.core.util.RecordingHistogramTest$MyRecordingHistogram"/>
    </Match>

    <!-- ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD in bytes time-provider perf tests: static volatile sinks prevent JVM from eliminating hot paths -->
    <Match>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
        <Class name="net.openhft.chronicle.bytes.DistributedUniqueTimeProviderTest"/>
    </Match>
    <Match>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
        <Class name="net.openhft.chronicle.bytes.MappedUniqueTimeProviderTest"/>
    </Match>

    <!-- DMI_HARDCODED_ABSOLUTE_FILENAME in PageUtilTest: Linux-only test guarded by OS and Files.exists checks -->
    <Match>
        <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME"/>
        <Class name="net.openhft.chronicle.bytes.PageUtilTest"/>
    </Match>

    <!-- PriorityHook: singleton hook manager has deliberate equals/getter semantics for backwards compatibility -->
    <Match>
        <Bug pattern="EC_UNRELATED_CLASS_AND_INTERFACE"/>
        <Class name="net.openhft.chronicle.core.shutdown.PriorityHook"/>
        <Method name="add"/>
    </Match>
    <Match>
        <Bug pattern="SING_SINGLETON_GETTER_NOT_SYNCHRONIZED"/>
        <Class name="net.openhft.chronicle.core.shutdown.PriorityHook"/>
        <Method name="getRegisteredHook"/>
    </Match>

    <!-- RecordingHistogram: relies on Histogram equality; extra sampleCount field is bookkeeping-only -->
    <Match>
        <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/>
        <Class name="net.openhft.chronicle.core.util.RecordingHistogram"/>
    </Match>
    <Match>
        <Bug pattern="URF_UNREAD_FIELD"/>
        <Class name="net.openhft.chronicle.core.util.RecordingHistogram"/>
        <Field name="sampleCount"/>
    </Match>

    <!-- DMI_RANDOM_USED_ONLY_ONCE in long-running or benchmarking tests where randomness is intentional -->
    <Match>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
        <Class name="net.openhft.chronicle.bytes.NativeBytesStoreTest"/>
    </Match>
    <Match>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
