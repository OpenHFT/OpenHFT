        <Class name="net.openhft.chronicle.core.internal.ClassUtilExtraTest$Parent"/>
    </Match>
    <Match>
        <Bug pattern="URF_UNREAD_FIELD"/>
        <Class name="net.openhft.chronicle.core.internal.ClassUtilExtraTest$Parent"/>
    </Match>
    <Match>
        <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/>
        <Class name="net.openhft.chronicle.core.internal.ClassUtilSetAccessibleTest$PkgClass"/>
    </Match>

    <!-- UPM in ScopedThreadLocalLifecycleTest: helper kept for future coverage of simple acquire/close -->
