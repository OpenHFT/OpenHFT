<?xml version="1.0" encoding="UTF-8"?>
<!--
  chronicle-spotbugs-exclude.xml

  Exclude filter for low-violation SpotBugs checks. Use this file sparingly:
  - Only add Match blocks for findings we have consciously decided to suppress.
  - Each suppression must be accompanied by a comment referencing the rationale
    (e.g. false positive, legacy API requirement, tracking ticket).

  Configure via the SpotBugs Maven plugin with:
    <excludeFilterFile>${project.basedir}/../chronicle-spotbugs-exclude.xml</excludeFilterFile>
-->
<FindBugsFilter>

    <!-- DM_GC: The 'forces garbage collection' rule is not part of the Chronicle low-violation gate.
         Explicit GC is used deliberately in tests and a few profiling hooks, so we disable DM_GC at
         filter level and rely on code review instead. -->
    <Match>
        <Bug pattern="DM_GC"/>
    </Match>

    <!-- SF_SWITCH_FALLTHROUGH: copyOne intentionally groups terminal tokens; branching verified via tests -->
    <Match>
        <Bug pattern="SF_SWITCH_FALLTHROUGH"/>
        <Class name="net.openhft.chronicle.wire.YamlWire"/>
        <Method name="copyOne"/>
    </Match>

    <!-- UC_USELESS_VOID_METHOD: Safepoint.force intentionally loops to trigger safepoint polling -->
    <Match>
        <Bug pattern="UC_USELESS_VOID_METHOD"/>
        <Class name="net.openhft.chronicle.core.Jvm$Safepoint"/>
        <Method name="force"/>
    </Match>

    <!-- UMAC: postInterrupt placeholder keeps compatibility with newer JDKs -->
    <Match>
        <Bug pattern="UMAC_UNCALLABLE_METHOD_OF_ANONYMOUS_CLASS"/>
        <Class name="net.openhft.chronicle.core.Jvm$1"/>
        <Method name="postInterrupt"/>
    </Match>

    <!-- MS_EXPOSE_REP: reusable() intentionally returns singleton instance for flow-control -->
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
        <Class name="net.openhft.chronicle.core.threads.InvalidEventHandlerException"/>
        <Method name="reusable"/>
    </Match>

    <!-- MS_EXPOSE_REP: NativeAccess.instance() intentionally returns a stateless singleton accessor -->
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
        <Class name="net.openhft.chronicle.algo.bytes.NativeAccess"/>
        <Method name="instance"/>
    </Match>

    <!-- MS_EXPOSE_REP: lock strategy singletons are stateless and intentionally shared -->
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
        <Class name="net.openhft.chronicle.algo.locks.VanillaReadWriteUpdateWithWaitsLockingStrategy"/>
        <Method name="instance"/>
    </Match>
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
        <Class name="net.openhft.chronicle.algo.locks.VanillaReadWriteWithWaitsLockingStrategy"/>
        <Method name="instance"/>
    </Match>

    <!-- MS_SHOULD_BE_FINAL: CLOCK is reassigned in tests to simulate different clocks -->
    <Match>
        <Bug pattern="MS_SHOULD_BE_FINAL"/>
        <Class name="net.openhft.chronicle.core.time.SystemTimeProvider"/>
        <Field name="CLOCK"/>
    </Match>

    <!-- MS_SHOULD_BE_FINAL: DISABLE_TCP_NODELAY stays mutable to honour legacy system-property overrides and public API expectations -->
    <Match>
        <Bug pattern="MS_SHOULD_BE_FINAL"/>
        <Class name="net.openhft.chronicle.network.TcpEventHandler"/>
        <Field name="DISABLE_TCP_NODELAY"/>
    </Match>

    <!-- MS_SHOULD_BE_FINAL: GENERATE_TUPLES toggled in tests/system properties so remains mutable -->
    <Match>
        <Bug pattern="MS_SHOULD_BE_FINAL"/>
        <Class name="net.openhft.chronicle.wire.Wires"/>
        <Field name="GENERATE_TUPLES"/>
    </Match>

    <!-- NM_SAME_SIMPLE_NAME_AS_INTERFACE: Chronicle Closeable intentionally shadows java.io.Closeable -->
    <Match>
        <Bug pattern="NM_SAME_SIMPLE_NAME_AS_INTERFACE"/>
        <Class name="net.openhft.chronicle.core.io.Closeable"/>
    </Match>

    <!-- MS_MUTABLE_ARRAY: char lookup table intentionally exposed for zero-allocation hex dumps -->
    <Match>
        <Bug pattern="MS_MUTABLE_ARRAY"/>
        <Class name="net.openhft.chronicle.bytes.internal.Chars"/>
        <Field name="charToString"/>
    </Match>

    <!-- SF_SWITCH_FALLTHROUGH / SF_SWITCH_NO_DEFAULT: MurmurHash_3 tail mixing uses intentional fallthrough for performance -->
    <Match>
        <Bug pattern="SF_SWITCH_FALLTHROUGH"/>
        <Class name="net.openhft.chronicle.algo.hashing.MurmurHash_3"/>
        <Method name="tailK1"/>
    </Match>
    <Match>
        <Bug pattern="SF_SWITCH_FALLTHROUGH"/>
        <Class name="net.openhft.chronicle.algo.hashing.MurmurHash_3"/>
        <Method name="tailK2"/>
    </Match>
    <Match>
        <Bug pattern="SF_SWITCH_NO_DEFAULT"/>
        <Class name="net.openhft.chronicle.algo.hashing.MurmurHash_3"/>
        <Method name="tailK1"/>
    </Match>
    <Match>
        <Bug pattern="SF_SWITCH_NO_DEFAULT"/>
        <Class name="net.openhft.chronicle.algo.hashing.MurmurHash_3"/>
        <Method name="tailK2"/>
    </Match>

    <!-- HSM_HIDING_METHOD: JSONWire keeps a convenience static asText in addition to TextWire for backwards compatibility -->
    <Match>
        <Bug pattern="HSM_HIDING_METHOD"/>
        <Class name="net.openhft.chronicle.wire.JSONWire"/>
        <Method name="asText"/>
    </Match>

    <!-- URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD: AbstractMapService exposes protected map/reply for subclasses -->
    <Match>
        <Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"/>
        <Class name="net.openhft.chronicle.map.channel.AbstractMapService"/>
    </Match>

    <!-- UC_USELESS_OBJECT: OSTest.testMap keeps anchors list only to pin mapped buffers in memory -->
    <Match>
        <Bug pattern="UC_USELESS_OBJECT"/>
        <Class name="net.openhft.chronicle.core.OSTest"/>
        <Method name="testMap"/>
    </Match>

    <!-- UUF/URF in JvmTest helper classes: layout-only fields used by Jvm.classMetrics -->
    <Match>
        <Bug pattern="UUF_UNUSED_FIELD"/>
        <Class name="net.openhft.chronicle.core.JvmTest$ClassA"/>
    </Match>
    <Match>
        <Bug pattern="UUF_UNUSED_FIELD"/>
        <Class name="net.openhft.chronicle.core.JvmTest$ClassB"/>
    </Match>
    <Match>
        <Bug pattern="UUF_UNUSED_FIELD"/>
        <Class name="net.openhft.chronicle.core.JvmTest$ClassC"/>
    </Match>
    <Match>
        <Bug pattern="UUF_UNUSED_FIELD"/>
        <Class name="net.openhft.chronicle.core.JvmTest$ClassD"/>
    </Match>
    <Match>
        <Bug pattern="UUF_UNUSED_FIELD"/>
        <Class name="net.openhft.chronicle.core.JvmTest$SomeClass"/>
    </Match>

    <!-- UUF/URF in UnsafeMemoryTest holders: reflective access exercises field layout -->
    <Match>
        <Bug pattern="UUF_UNUSED_FIELD"/>
        <Class name="net.openhft.chronicle.core.UnsafeMemoryTest$1CharHolder"/>
    </Match>
    <Match>
        <Bug pattern="UUF_UNUSED_FIELD"/>
        <Class name="net.openhft.chronicle.core.UnsafeMemoryTest$1FloatHolder"/>
    </Match>
    <Match>
        <Bug pattern="UUF_UNUSED_FIELD"/>
        <Class name="net.openhft.chronicle.core.UnsafeMemoryTest$1ObjectHolder"/>
    </Match>
    <Match>
        <Bug pattern="URF_UNREAD_FIELD"/>
        <Class name="net.openhft.chronicle.core.UnsafeMemoryTest$TestClass"/>
    </Match>

    <!-- UPM/URF in reflection-focused ClassUtil tests: private members are probed reflectively -->
    <Match>
