    </Match>
    <Match>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
        <Class name="net.openhft.chronicle.bytes.util.LZWTest"/>
    </Match>

    <!-- UPM / UUF / URF in NotNullHandlingTest and BytesFieldInfoTest: shape-only fixtures or assertion-only helpers -->
    <Match>
        <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/>
        <Class name="net.openhft.chronicle.bytes.NotNullHandlingTest"/>
        <Method name="fooZeroCost"/>
    </Match>
    <Match>
        <Bug pattern="UUF_UNUSED_FIELD"/>
        <Class name="net.openhft.chronicle.bytes.internal.BytesFieldInfoTest$Groups1"/>
    </Match>

    <!-- DMI_RANDOM_USED_ONLY_ONCE in MappedBytes boundary-underflow stress test -->
    <Match>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
        <Class name="net.openhft.chronicle.bytes.MappedBytesTest"/>
    </Match>

    <!-- HashWire hashing: integer-overflow in multipliers is intentional and part of the stable hash contract -->
    <Match>
        <Bug pattern="ICAST_INTEGER_MULTIPLY_CAST_TO_LONG"/>
        <Class name="net.openhft.chronicle.wire.HashWire$HashValueOut"/>
    </Match>

